import { VerticalBox, HorizontalBox, Button, ComboBox, ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Operation Logger";
    min-height: 440px;
    min-width: 680px;

    in-out property <[string]> app_items: [];
    in-out property <int> selected_index: -1;
    in-out property <bool> logging: false;
    in-out property <bool> starting: false;
    in-out property <bool> start_failed: false;
    in-out property <bool> has_log_dir: false;
    in-out property <string> selected_title: "-";
    in-out property <string> selected_process_name: "-";
    in-out property <string> selected_process_id: "-";
    in-out property <string> local_participant_id: "-";
    in-out property <string> status_text: "Ready";

    callback refresh_clicked();
    callback selection_changed(index: int);
    callback start_clicked();
    callback stop_clicked();
    callback open_folder_clicked();

    VerticalBox {
        padding: 12px;
        spacing: 10px;

        Text {
            text: "local_participant_id: " + root.local_participant_id;
        }

        HorizontalBox {
            spacing: 8px;
            app_selector := ComboBox {
                model: root.app_items;
                current-index <=> root.selected_index;
                enabled: !root.logging && !root.starting;
                selected => {
                    root.selection_changed(app_selector.current-index);
                }
            }
            Button {
                text: "Refresh";
                enabled: !root.logging && !root.starting;
                clicked => { root.refresh_clicked(); }
            }
        }

        Rectangle {
            border-width: 1px;
            border-color: #cccccc;
            border-radius: 4px;
            height: 80px;

            VerticalBox {
                padding: 10px;
                spacing: 6px;
                alignment: center;
                Text { text: "title: " + root.selected_title; }
                Text { text: "process_name: " + root.selected_process_name; }
                Text { text: "process_id: " + root.selected_process_id; }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: root.starting ? (root.start_failed ? "Cleaning up..." : "Starting...") : "Start";
                enabled: !root.logging && !root.starting && root.selected_index >= 0;
                clicked => { root.start_clicked(); }
            }
            Button {
                text: "Stop";
                enabled: root.logging;
                clicked => { root.stop_clicked(); }
            }
            Button {
                text: "Open Folder";
                enabled: root.has_log_dir;
                clicked => { root.open_folder_clicked(); }
            }
        }

        Rectangle {
            border-width: 1px;
            border-radius: 4px;
            min-height: 120px;
            vertical-stretch: 1;
            background: root.start_failed ? #fff0f0 : #ffffff;
            // Keep long OS/rollback errors readable without truncation.
            border-color: root.start_failed ? #b00020 : #cccccc;

            ScrollView {
                viewport-width: self.visible-width;
                VerticalBox {
                    padding: 10px;
                    Text {
                        text: root.status_text;
                        color: root.start_failed ? #b00020 : #222222;
                        font-weight: root.start_failed ? 700 : 400;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
